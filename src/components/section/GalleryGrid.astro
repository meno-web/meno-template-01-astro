---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Gallery" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Project" },
      text: { type: "string", default: "Project description" }
    },
    default: [
      {
        image: "/images/placeholder-img.webp",
        title: "Item one",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item two",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item three",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item four",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item five",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item six",
        text: "Short caption for this gallery item"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="600px">
    {subtitle && (
      <Subtitle text={subtitle} align="center" fade="0" />
    )}
    <Heading text={title} maxWidth="" align="center" size="2" tag="2" fade="0.2" />
    {text && (
      <Text text={text} size="large" align="center" maxWidth="" fade="0.4" />
    )}
  </SectionHeader>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({
          base: {
            position: "relative",
            borderRadius: "12px",
            overflow: "hidden",
            aspectRatio: "4/3"
          }
        }, __props, {
          interactive: [
            {
              prefix: "",
              postfix: ":hover [data-el='overlay']",
              style: { base: { opacity: "1" } }
            }
          ]
        })}>
        <img class={style({
            base: {
              width: "100%",
              height: "100%",
              objectFit: "cover",
              transition: "transform 0.3s ease"
            }
          }, __props)} src={item.image || undefined} alt={item.title || undefined} />
        <div class={style({
            base: {
              position: "absolute",
              bottom: "0",
              left: "0",
              right: "0",
              padding: "24px",
              background: "linear-gradient(transparent, rgba(0,0,0,0.7))",
              opacity: "0",
              transition: "opacity 0.3s ease"
            }
          }, __props)} data-el="overlay"><p class={style({ base: { color: "#ffffff", fontSize: "14px", margin: "0" } }, __props)}>{item.text}</p></div>
      </div>
    ))}
  </Grid>
</Section>
