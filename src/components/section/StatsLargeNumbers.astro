---
import { cx, list, resolveProps, style, variants } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Results" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  isCenter: { type: "boolean", default: false },
  items: {
    type: "list",
    itemSchema: {
      value: { type: "string", default: "100+" },
      label: { type: "string", default: "Label" },
      description: { type: "string", default: "" }
    },
    default: [
      {
        value: "2.5M+",
        label: "Stat label",
        description: "Short description of this statistic that previews how the row looks."
      },
      {
        value: "99.9%",
        label: "Stat label",
        description: "Short description of this statistic that previews how the row looks."
      },
      {
        value: "< 50ms",
        label: "Stat label",
        description: "Short description of this statistic that previews how the row looks."
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  isCenter,
  items,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={variants(__props, {
      isCenter: {
        default: "items-start",
        true: "items-center",
        false: "items-start"
      }
    }) + " mr-auto mb-(--sh-mb) ml-auto flex flex-col"}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={cx(style({ base: {}, tablet: {}, mobile: {} }, __props, { instance: true }), variants(__props, {
          isCenter: { default: "text-left", true: "text-center", false: "text-left" }
        }))} __menoStyle={{
          base: {
            textAlign: {
              _mapping: true,
              prop: "isCenter",
              values: { default: "left", true: "center", false: "left" }
            }
          },
          tablet: {},
          mobile: {}
        }} />
    )}
    <Heading text={title} fade="0.2" size="2" tag="2" class={cx(style({ base: {} }, __props, { instance: true }), variants(__props, {
        isCenter: { default: "text-left", true: "text-center", false: "text-left" }
      })) + " max-w-[640px]"} __menoStyle={{
        base: {
          textAlign: {
            _mapping: true,
            prop: "isCenter",
            values: { default: "left", true: "center", false: "left" }
          }
        }
      }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={cx(style({ base: {} }, __props, { instance: true }), variants(__props, {
          isCenter: { default: "text-left", true: "text-center", false: "text-left" }
        })) + " max-w-[580px]"} __menoStyle={{
          base: {
            textAlign: {
              _mapping: true,
              prop: "isCenter",
              values: { default: "left", true: "center", false: "left" }
            }
          }
        }} />
    )}
  </div>
  <Grid columns="1" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({}, __props, { label: "Stat Row" }) + " p-[32px_0] flex items-center gap-8 border-b-[1px_solid_var(--border)] max-sm:flex-col max-sm:items-start max-sm:gap-4"}>
        <div class={style({}, __props, { label: "Value Wrap" }) + " min-w-[180px] max-sm:min-w-auto"}><Heading text={item.value} size="2" tag="3" color="primary" isMb0={true} /></div>
        <div class={style({}, __props, { label: "Content" }) + " flex flex-col gap-2"}>
          <Heading text={item.label} size="4" tag="4" />
          {item.description && (
            <Text text={item.description} color="secondary" class="max-w-[500px]" />
          )}
        </div>
      </div>
    ))}
  </Grid>
</Section>
