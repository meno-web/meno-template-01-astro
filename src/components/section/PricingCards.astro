---
import { list, resolveProps, style } from 'meno-astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import StatNumber from '../ui/StatNumber.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Pricing" },
  title: { type: "rich-text", default: "Simple, transparent pricing" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Plan Name" },
      value: { type: "string", default: "$9" },
      label: { type: "string", default: "/month" },
      text: { type: "rich-text", default: "Feature 1\nFeature 2\nFeature 3" },
      buttonText: { type: "string", default: "Get started" },
      link: { type: "link", default: "#" }
    },
    default: [
      {
        title: "Starter",
        value: "$9",
        label: "/month",
        text: "Included feature one\nIncluded feature two\nIncluded feature three\nIncluded feature four",
        buttonText: "Primary action",
        link: "#"
      },
      {
        title: "Professional",
        value: "$29",
        label: "/month",
        text: "Included feature one\nIncluded feature two\nIncluded feature three\nIncluded feature four",
        buttonText: "Primary action",
        link: "#"
      },
      {
        title: "Enterprise",
        value: "$99",
        label: "/month",
        text: "Included feature one\nIncluded feature two\nIncluded feature three\nIncluded feature four",
        buttonText: "Primary action",
        link: "#"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "600px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Card item={item}>
        <div class={style({ base: { display: "flex", flexDirection: "column", height: "100%" } }, __props)}>
          <Heading text={item.title} size="5" tag="3" />
          <div class={style({ base: { display: "flex", alignItems: "baseline", gap: "4px" } }, __props)}>
            <StatNumber text={item.value} />
            <Text text={item.label} variant="light" size="small" />
          </div>
          <Spacer size="16" />
          <Text text={item.text} variant="light" />
          <Spacer size="32" />
          <div class={style({ base: { display: "flex" }, tablet: {}, mobile: {} }, __props)}><Button text={item.buttonText} link={item.link} variant="primary" /></div>
        </div>
      </Card>
    ))}
  </Grid>
</Section>
