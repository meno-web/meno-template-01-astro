---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, { fade: { type: "string", default: "" } });
const { fade, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<div class={cx("m-[0_auto] bg-bg border-[1px_solid] rounded-[8px] border-border overflow-hidden", className)} fade={fade || undefined}><slot /></div>
