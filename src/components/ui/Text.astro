---
import { cx, resolveProps, richTextWithComponents, variants } from 'meno-astro';
import { cmsComponents } from '../../cmsComponents';

const __props = resolveProps(Astro, {
  size: {
    type: "select",
    default: "default",
    options: ["default", "large", "small"]
  },
  text: { type: "rich-text", default: "Text" },
  fade: { type: "string", default: "" }
});
const { size, text, fade, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={cx(variants(__props, {
    size: {
      default: "text-(length:--t-fs)",
      large: "text-(length:--tl-fs)",
      small: "text-(length:--ts-fs)"
    }
  }), "text-text font-(number:--t-fw) leading-[150%]", className)} fade={fade || undefined}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></p>
