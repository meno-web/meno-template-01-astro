---
import { cx, resolveProps, style } from 'meno-astro';
import Banner from './Banner.astro';
import FooterMultiColumn from './FooterMultiColumn.astro';
import Navigation from './Navigation.astro';

const __props = resolveProps(Astro, {});
const { class: className } = __props;
---
<div class={cx("bg-bg font-(--l-ff)", className)} theme="light" data-theme-root="true">
  <Banner text="Welcome! Check out our latest features and updates" variant="default" isDismissible={true} />
  <Navigation isOpen={false} />
  <main class={style({}, __props, { label: "main" })}><slot /></main>
  <FooterMultiColumn section_bg="white" />
</div>
