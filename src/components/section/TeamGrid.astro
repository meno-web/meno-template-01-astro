---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Our Team" },
  title: { type: "rich-text", default: "Meet the team" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Name" },
      text: { type: "string", default: "Role" }
    },
    default: [
      {
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        text: "Job title"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        text: "Job title"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        text: "Job title"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        text: "Job title"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "600px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <Grid columns="4" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({ base: { textAlign: "center" } }, __props)}>
        <div class={style({
            base: {
              width: "160px",
              height: "160px",
              borderRadius: "50%",
              overflow: "hidden",
              marginBottom: "16px",
              marginLeft: "auto",
              marginRight: "auto"
            }
          }, __props)}><Image image={item.image} alt={item.title} objectFit="cover" width="100%" height="100%" /></div>
        <Heading text={item.title} size="5" tag="3" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
        <Text text={item.text} size="small" class={style({ base: { textAlign: "center", color: "var(--text-100)" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center", color: "var(--text-100)" }, tablet: {}, mobile: {} }} />
      </div>
    ))}
  </Grid>
</Section>
