---
import { BaseLayout } from 'meno-astro/components';
import BlogCardGrid from '../components/section/BlogCardGrid.astro';
import CTACentered from '../components/section/CTACentered.astro';
import FaqAccordion from '../components/section/FaqAccordion.astro';
import HeroCentered from '../components/section/HeroCentered.astro';
import Layout from '../components/layout/Layout.astro';
import SliderCards from '../components/section/SliderCards.astro';
import TimelineVertical from '../components/section/TimelineVertical.astro';
import '../styles/theme.css';

const meta = {
  title: "Meno Starter Template",
  description: "A clean, customizable starter template for Meno. Includes 40+ components, responsive design, and CMS support — ready to make your own."
};
---
<BaseLayout meta={meta}>
  <Layout>
    <HeroCentered title={`Everything you need to build <span class="custom-span">professional</span> website`} text="Design and publish professional websites without writing code. Start with this template and make it yours in minutes." theme="light" />
    <SliderCards />
    <TimelineVertical title="Simple steps to get started" subtitle="How It Works" text="Follow these easy steps to begin your journey with us." items={[
        {
          title: "Sign up for free",
          text: "Create your account in seconds. No credit card required to get started."
        },
        {
          title: "Set up your project",
          text: "Configure your workspace and invite your team members to collaborate."
        },
        {
          title: "Customize your workflow",
          text: "Tailor the platform to fit your specific needs and preferences."
        },
        {
          title: "Launch and grow",
          text: "Go live and start achieving your goals with our powerful tools."
        }
      ]} />
    <FaqAccordion theme="primary" text="Short supporting description that previews how this section looks and reads in the editor." />
    <BlogCardGrid items={[
        {
          image: "/images/placeholder-img.webp",
          label: "Technology",
          title: "Getting Started with Modern Web Development",
          text: "Learn the fundamentals of modern web development and best practices for building scalable applications.",
          link: "#",
          date: "Jan 15, 2025"
        },
        {
          image: "/images/placeholder-img.webp",
          label: "Business",
          title: "Scaling Your Startup: Lessons Learned",
          text: "Key insights and strategies for growing your startup from seed to series A.",
          link: "#",
          date: "Jan 5, 2025"
        },
        {
          image: "/images/placeholder-img.webp",
          label: "Design",
          title: "Design Systems: A Complete Guide",
          text: "How to build and maintain a design system that scales with your organization.",
          link: "#",
          date: "Jan 10, 2025"
        }
      ]} subtitle="Blog" title="Latest articles" text="Stay up to date with the latest news, tips, and insights." />
    <CTACentered theme="dark" />
  </Layout>
</BaseLayout>
