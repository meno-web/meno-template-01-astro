---
import { list, resolveProps, style } from 'meno-astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Features" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  theme: { type: "select", default: "primary", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Feature Title" },
      text: { type: "rich-text", default: "Feature description goes here." },
      features: {
        type: "rich-text",
        default: "Feature 1\nFeature 2\nFeature 3\nFeature 4"
      }
    },
    default: [
      {
        title: "Feature title",
        text: "Short description of this item that previews how the card looks and reads in the editor.",
        features: "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
      },
      {
        title: "Feature title",
        text: "Short description of this item that previews how the card looks and reads in the editor.",
        features: "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
      },
      {
        title: "Feature title",
        text: "Short description of this item that previews how the card looks and reads in the editor.",
        features: "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
      },
      {
        title: "Feature title",
        text: "Short description of this item that previews how the card looks and reads in the editor.",
        features: "Supporting point one\nSupporting point two\nSupporting point three\nSupporting point four"
      }
    ]
  }
});
const { subtitle, title, text, theme, items, class: className } = __props;
---
<Section spaceTop="default" spaceBottom="default" theme={theme} class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "450px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" isMarginBottom={true} fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <Grid columns="2" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Card item={item}>
        <Heading text={item.title} size="3" tag="3" />
        <Text text={item.text} isMarginBottom={true} />
        <Spacer size="24" />
        <div class={style({
            base: {
              fontSize: "15px",
              lineHeight: "1.8",
              color: "var(--text-secondary)"
            }
          }, __props)}>{item.features}</div>
      </Card>
    ))}
  </Grid>
</Section>
