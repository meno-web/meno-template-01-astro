---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import SplitContent from '../ui/SplitContent.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Features" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  leftText: {
    type: "rich-text",
    default: "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that speaks to your audience and supports the heading above."
  },
  rightText: {
    type: "rich-text",
    default: "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that continues the narrative from the left column."
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  leftText,
  rightText,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} maxWidth="500px">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" align="center" />
    )}
    <Heading text={title} maxWidth="" fade="0.2" align="center" size="2" tag="2" />
    {text && (
      <Text text={text} size="large" fade="0.4" align="center" maxWidth="" isMarginBottom={true} />
    )}
  </SectionHeader>
  <SplitContent>
    <Text text={leftText} fade="0.4" size="default" align="left" maxWidth="100%" />
    <Text text={rightText} fade="0.6" size="default" align="left" maxWidth="100%" />
  </SplitContent>
</Section>
