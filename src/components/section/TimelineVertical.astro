---
import { list, resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "How It Works" },
  title: { type: "rich-text", default: "Simple steps to get started" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      title: { type: "string", default: "Step title" },
      text: { type: "string", default: "Step description" }
    },
    default: [
      {
        title: "Step one",
        text: "Short description of this step that previews how the timeline looks and reads in the editor."
      },
      {
        title: "Step two",
        text: "Short description of this step that previews how the timeline looks and reads in the editor."
      },
      {
        title: "Step three",
        text: "Short description of this step that previews how the timeline looks and reads in the editor."
      },
      {
        title: "Step four",
        text: "Short description of this step that previews how the timeline looks and reads in the editor."
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "600px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <div class={style({ base: { maxWidth: "700px", margin: "0 auto" } }, __props)}>
    {list(items).map((item, itemIndex, itemArr) => (
      <div class={style({ base: { display: "flex", gap: "24px" }, mobile: { gap: "16px" } }, __props)} fade={0.4+0.2*itemIndex || undefined}>
        <div class={style({
            base: {
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              flexShrink: "0"
            }
          }, __props)}>
          <div class={style({
              base: {
                width: "32px",
                height: "32px",
                minWidth: "32px",
                minHeight: "32px",
                backgroundColor: "var(--text)",
                borderRadius: "50%",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
                color: "#ffffff",
                fontWeight: "700",
                fontSize: "14px"
              }
            }, __props)}>{itemIndex}</div>
          {!(itemIndex === itemArr.length - 1) && (
            <div class={style({
                base: {
                  width: "2px",
                  flex: "1",
                  backgroundColor: "var(--border)",
                  marginTop: "8px",
                  marginBottom: "-8px"
                }
              }, __props)} />
          )}
        </div>
        <div class={style({ base: { paddingBottom: "48px", flex: "1", minWidth: "0" } }, __props)}>
          <Heading text={item.title} size="5" tag="3" />
          <Text text={item.text} variant="light" />
        </div>
      </div>
    ))}
  </div>
</Section>
