---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Integrations" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      icon: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Integration" },
      text: { type: "string", default: "Description" }
    },
    default: [
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center max-w-[600px]">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="text-center" />
    {text && (
      <Text text={text} size="large" fade="0.4" class="text-center" />
    )}
  </div>
  <Grid columns="4" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class="p-6 bg-surface border-[1px_solid_var(--border-100)] rounded-[12px] text-center transition-[transform_0.2s_ease,_box-shadow_0.2s_ease] hover:transform-[translateY(-4px)] hover:shadow-[0_8px_24px_rgba(0,_0,_0,_0.08)]">
        <div class="mb-4 inline-block"><Image image={item.icon} alt={item.title} objectFit="contain" width="48px" height="48px" class="h-8" /></div>
        <Heading text={item.title} size="6" tag="3" class="text-center" />
        <Text text={item.text} size="small" class="text-[var(--text-100)] text-center" />
      </div>
    ))}
  </Grid>
</Section>
