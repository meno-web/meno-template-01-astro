---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  isCenter: { type: "boolean", default: false },
  fade: { type: "string", default: "" }
});
const { isCenter, fade, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<div class={style({
    base: {
      display: "flex",
      flexDirection: "column",
      alignItems: {
        _mapping: true,
        prop: "isCenter",
        values: { default: "flex-start", true: "center", false: "flex-start" }
      },
      marginBottom: "80px",
      textAlign: {
        _mapping: true,
        prop: "isCenter",
        values: { default: "left", true: "center", false: "left" }
      },
      marginRight: "auto",
      marginLeft: "auto"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} fade={fade || undefined}><slot /></div>
