---
import { resolveProps, style } from 'meno-astro';
import Button from '../ui/Button.astro';
import ButtonList from '../ui/ButtonList.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: {
    type: "rich-text",
    default: "Your headline, <span>highlighted phrase</span>"
  },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  buttonText: { type: "string", default: "Primary action" },
  buttonLink: { type: "link", default: "#" },
  secondaryButtonText: { type: "string", default: "" },
  secondaryButtonLink: { type: "link", default: "#" },
  theme: { type: "select", default: "light", enumName: "theme" }
});
const {
  title,
  text,
  buttonText,
  buttonLink,
  secondaryButtonText,
  secondaryButtonLink,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} class={style({}, __props, { root: true })}>
  <Stack horizontal="center">
    <Heading text={title} size="1" fade="0" isMb0={false} class={style({
        base: { maxWidth: "900px", textAlign: "center", color: "var(--text-100)" },
        tablet: {},
        mobile: {}
      }, __props, { instance: true })} __menoStyle={{
        base: { maxWidth: "900px", textAlign: "center", color: "var(--text-100)" },
        tablet: {},
        mobile: {}
      }} />
    {text && (
      <Text text={text} size="large" fade="0.2" class={style({
          base: { maxWidth: "650px", textAlign: "center", color: "var(--text-100)" },
          tablet: {},
          mobile: {}
        }, __props, { instance: true })} __menoStyle={{
          base: { maxWidth: "650px", textAlign: "center", color: "var(--text-100)" },
          tablet: {},
          mobile: {}
        }} />
    )}
    {buttonText && (
      <ButtonList fade="0.4">
        <Button text={buttonText} link={buttonLink} />
        {secondaryButtonText && (
          <Button text={secondaryButtonText} link={secondaryButtonLink} variant="secondary" />
        )}
      </ButtonList>
    )}
  </Stack>
</Section>
