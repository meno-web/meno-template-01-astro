---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import Stack from '../ui/Stack.astro';

const __props = resolveProps(Astro, {
  quote: {
    type: "rich-text",
    default: "\"A short testimonial quote goes here about a positive experience with your brand or offering.\""
  },
  avatar: {
    type: "file",
    accept: "image/*",
    default: "/images/placeholder-img.webp"
  },
  name: { type: "string", default: "Jane Doe" },
  role: { type: "string", default: "Job title, Company Name" },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { quote, avatar, name, role, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" maxWidth="900" class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    <blockquote class={style({ base: { margin: "0", padding: "0" } }, __props)}><Heading text={quote} align="center" size="2" tag="3" fade="0" /></blockquote>
    <Spacer size="32" />
    <div class={style({ base: { display: "flex", alignItems: "center", gap: "16px" } }, __props)} fade={0.2}>
      <img class={style({
          base: {
            width: "56px",
            height: "56px",
            borderRadius: "50%",
            objectFit: "cover"
          }
        }, __props)} src={avatar || undefined} alt={name || undefined} />
      <div>
        <div class={style({ base: { fontWeight: "600", color: "var(--text)" } }, __props)}>{name}</div>
        <div class={style({ base: { color: "var(--text-secondary)", fontSize: "14px" } }, __props)}>{role}</div>
      </div>
    </div>
  </Stack>
</Section>
