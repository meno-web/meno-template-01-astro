---
import { list, resolveProps, style } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Gallery" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Project" },
      text: { type: "string", default: "Project description" }
    },
    default: [
      {
        image: "/images/placeholder-img.webp",
        title: "Item one",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item two",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item three",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item four",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item five",
        text: "Short caption for this gallery item"
      },
      {
        image: "/images/placeholder-img.webp",
        title: "Item six",
        text: "Short caption for this gallery item"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center max-w-[600px]">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="text-center" />
    {text && (
      <Text text={text} size="large" fade="0.4" class="text-center" />
    )}
  </div>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({}, __props, {
          interactive: [
            {
              prefix: "",
              postfix: ":hover [data-el='overlay']",
              style: { base: { opacity: "1" } }
            }
          ]
        }) + " aspect-[4/3] rounded-[12px] relative overflow-hidden"}>
        <MenoImage src={item.image || undefined} alt={item.title || undefined} class="w-full h-full transition-[transform_0.3s_ease] object-cover" />
        <div data-el="overlay" class="p-6 [background:linear-gradient(transparent,_rgba(0,0,0,0.7))] opacity-0 absolute right-[0] bottom-[0] left-[0] transition-[opacity_0.3s_ease]"><p class="m-[0] text-[#ffffff] text-[14px]">{item.text}</p></div>
      </div>
    ))}
  </Grid>
</Section>
