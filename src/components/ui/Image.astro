---
import { resolveProps, style } from 'meno-astro';
import { MenoImage } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  alt: { type: "string", default: "" },
  loading: { type: "select", default: "lazy", options: ["lazy", "eager"] },
  objectFit: {
    type: "select",
    default: "cover",
    options: ["cover", "contain", "fill", "scale-down"]
  },
  image: {
    type: "file",
    default: "/images/placeholder-img.webp",
    accept: "image/*"
  },
  fetchpriority: {
    type: "select",
    default: "auto",
    options: ["auto", "high", "low"]
  },
  sizes: { type: "string", default: "" },
  aspectRatio: { type: "string", default: "" },
  fade: { type: "string", default: "" }
});
const {
  alt,
  loading,
  objectFit,
  image,
  fetchpriority,
  sizes,
  aspectRatio,
  fade,
  class: className,
} = __props;

const __meno = { acceptsStyles: true };
---
<MenoImage class={style({ base: { objectFit: "{{objectFit}}", aspectRatio: "{{aspectRatio}}" } }, __props) + " block w-full h-full border-border"} style={`--m-base-object-fit: ${objectFit}; --m-base-aspect-ratio: ${aspectRatio}`} src={image || undefined} alt={alt || undefined} loading={loading || undefined} fetchpriority={fetchpriority || undefined} sizes={sizes || undefined} fade={fade || undefined} />
