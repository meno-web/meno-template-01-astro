---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Integrations" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      icon: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Integration" },
      text: { type: "string", default: "Description" }
    },
    default: [
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      },
      {
        icon: "/images/placeholder-img.webp",
        title: "Item title",
        text: "Short caption"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} class={style({ base: { maxWidth: "600px" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "600px" }, tablet: {}, mobile: {} }}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </SectionHeader>
  <Grid columns="4" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({
          base: {
            backgroundColor: "var(--surface)",
            borderRadius: "12px",
            padding: "24px",
            border: "1px solid var(--border-100)",
            textAlign: "center",
            transition: "transform 0.2s ease, box-shadow 0.2s ease"
          },
          tablet: {},
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "",
              postfix: ":hover",
              style: {
                base: {
                  transform: "translateY(-4px)",
                  boxShadow: "0 8px 24px rgba(0, 0, 0, 0.08)"
                }
              }
            }
          ]
        })}>
        <div class={style({ base: { marginBottom: "16px", display: "inline-block" } }, __props)}><Image image={item.icon} alt={item.title} objectFit="contain" width="48px" height="48px" class={style({ base: { height: "32px" } }, __props, { instance: true })} __menoStyle={{ base: { height: "32px" } }} /></div>
        <Heading text={item.title} size="6" tag="3" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
        <Text text={item.text} size="small" variant="light" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
      </div>
    ))}
  </Grid>
</Section>
