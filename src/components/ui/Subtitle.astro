---
import { cx, resolveProps } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "SUBTITLE" },
  fade: { type: "string", default: "" }
});
const { text, fade, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={cx("mb-4 text-text text-[14px] font-[600] no-underline uppercase leading-[115%] tracking-[-0.015em]", className)} fade={fade || undefined}>{text}</p>
