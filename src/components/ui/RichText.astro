---
import { cx, resolveProps, richTextWithComponents } from 'meno-astro';
import { cmsComponents } from '../../cmsComponents';

const __props = resolveProps(Astro, {
  fade: { type: "string", default: "" },
  content: { type: "rich-text", default: "Rich text", editor: "extended" }
});
const { fade, content, class: className } = __props;
---
<div class={cx("text-text text-[18px] leading-[1.7] tracking-[-0.01em]", className)} cmsrt={true} fade={fade || undefined}><Fragment set:html={richTextWithComponents(content, cmsComponents)} /></div>


<style is:global>
[cmsrt] h1,
[cmsrt] h2,
[cmsrt] h3,
[cmsrt] h4,
[cmsrt] h5,
[cmsrt] h6 {
  font-weight: 450;
  margin-top: 32px;
  margin-bottom: 4px;
}

[cmsrt] h2 {
  font-size: 36px;
}
</style>