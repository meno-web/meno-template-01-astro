---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Features" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  columns: { type: "select", default: "3", options: ["2", "3", "4", "6"] },
  theme: { type: "select", default: "light", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      icon: { type: "select", default: "zap", enumName: "icons" },
      title: { type: "string", default: "Feature" },
      text: { type: "rich-text" }
    },
    default: [
      {
        icon: "zap",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "settings",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "shield",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "headphones",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "trending-up",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "bar-chart-3",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      }
    ]
  }
});
const {
  subtitle,
  title,
  text,
  columns,
  theme,
  items,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center max-w-[640px]">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="text-center" />
    {text && (
      <Text text={text} size="large" fade="0.4" class="max-w-[400px] text-center" />
    )}
  </div>
  <Grid columns={columns} fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({}, __props, { label: "Card" }) + " p-[32px_24px] flex flex-col items-center [background:var(--bg-100)] rounded-[12px] text-center"}>
        <div class={style({}, __props, { label: "Icon Wrap" }) + " mb-5 flex justify-center items-center w-16 h-16 bg-[var(--bg-200)] rounded-[16px]"}><Icon size={24} icon={item.icon} color="" /></div>
        <Heading text={item.title} size="5" tag="3" class="text-center" />
        <Text text={item.text} size="small" class="text-[var(--text-100)] text-center" />
      </div>
    ))}
  </Grid>
</Section>
