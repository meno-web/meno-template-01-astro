---
import { list, resolveProps, style } from 'meno-astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import StatNumber from '../ui/StatNumber.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "How It Works" },
  title: { type: "rich-text", default: "Simple steps to get started" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  theme: { type: "select", default: "light", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      value: { type: "string", default: "1" },
      title: { type: "string", default: "Step title" },
      text: { type: "string", default: "Step description" }
    },
    default: [
      {
        value: "1",
        title: "Step one",
        text: "Short description of this step that previews how the card looks and reads in the editor."
      },
      {
        value: "2",
        title: "Step two",
        text: "Short description of this step that previews how the card looks and reads in the editor."
      },
      {
        value: "3",
        title: "Step three",
        text: "Short description of this step that previews how the card looks and reads in the editor."
      }
    ]
  }
});
const { subtitle, title, text, theme, items, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center max-w-[600px]">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="text-center" />
    {text && (
      <Text text={text} size="large" fade="0.4" class="text-center" />
    )}
  </div>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Card variant="light">
        <StatNumber text={item.value} />
        <Heading text={item.title} size="3" tag="3" />
        <Text text={item.text} />
      </Card>
    ))}
  </Grid>
</Section>
