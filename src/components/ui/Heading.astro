---
import { cx, resolveProps, richTextWithComponents, style, variants } from 'meno-astro';
import { cmsComponents } from '../../cmsComponents';

const __props = resolveProps(Astro, {
  text: { type: "rich-text", default: "Heading" },
  size: {
    type: "select",
    default: "1",
    options: ["1", "2", "3", "4", "5", "6"]
  },
  tag: {
    type: "select",
    default: "size",
    options: ["1", "2", "3", "4", "5", "6", "size"]
  },
  fade: { type: "string", default: "" },
  isMb0: { type: "boolean", default: false }
});
const { text, size, tag, fade, isMb0, class: className } = __props;

const __meno = { acceptsStyles: true };

const Tag_0 = `h${tag === "size" ? size : tag}`;
---
<Tag_0 class={cx(style({ base: {} }, __props, { label: "Text" }), variants(__props, {
    size: {
      "1": "text-(length:--h-fs) mb-(--h-s)",
      "2": "text-(length:--h2-fs) mb-(--h2-s)",
      "3": "text-(length:--h3-fs) mb-(--h3-s)",
      "4": "text-(length:--h4-fs) mb-(--h4-s)",
      "5": "text-(length:--h5-fs) mb-(--h5-s)",
      "6": "text-(length:--h6-fs) mb-(--h6-s)",
      default: "text-[95px] mb-5"
    }
  }), "text-text font-(number:--h-fw) leading-(--h-lh) tracking-(--h-ls)", className)} fade={fade || undefined} isMb0={isMb0 || undefined}><Fragment set:html={richTextWithComponents(text, cmsComponents)} /></Tag_0>


<style is:global>
h1 .custom-span,
h2 .custom-span,
h3 .custom-span,
h4 .custom-span,
h5 .custom-span { color: var(--h-span); }

[is-mb0], [isMb0] {
  margin-bottom: 0 !important;
}
</style>