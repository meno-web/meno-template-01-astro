---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Stack from '../ui/Stack.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Content 01" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor. Replace this placeholder copy with your own message."
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" maxWidth="900" class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="max-w-[640px] text-center" />
    {text && (
      <Text text={text} size="large" fade="0.4" class="text-center" />
    )}
  </Stack>
</Section>
