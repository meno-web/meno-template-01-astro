---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "SUBTITLE" },
  fade: { type: "string", default: "" }
});
const { text, fade, class: className } = __props;

const __meno = { acceptsStyles: true };
---
<p class={style({
    base: {
      fontSize: "14px",
      fontWeight: "600",
      marginBottom: "16px",
      letterSpacing: "-0.015em",
      lineHeight: "115%",
      color: "var(--text)",
      textDecoration: "none",
      textTransform: "uppercase"
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} fade={fade || undefined}>{text}</p>
