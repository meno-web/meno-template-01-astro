---
import { cx, list, resolveProps, style, variants } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Performance" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  isCenter: { type: "boolean", default: false },
  items: {
    type: "list",
    itemSchema: {
      label: { type: "string", default: "Metric" },
      value: { type: "number", default: 75 },
      description: { type: "string", default: "" }
    },
    default: [
      {
        label: "Metric one",
        value: 95,
        description: "Short description of this metric"
      },
      {
        label: "Metric two",
        value: 88,
        description: "Short description of this metric"
      },
      {
        label: "Metric three",
        value: 92,
        description: "Short description of this metric"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  isCenter,
  items,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={variants(__props, {
      isCenter: {
        default: "items-start",
        true: "items-center",
        false: "items-start"
      }
    }) + " mr-auto mb-(--sh-mb) ml-auto flex flex-col"}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={cx(style({ base: {}, tablet: {}, mobile: {} }, __props, { instance: true }), variants(__props, {
          isCenter: { default: "text-left", true: "text-center", false: "text-left" }
        }))} __menoStyle={{
          base: {
            textAlign: {
              _mapping: true,
              prop: "isCenter",
              values: { default: "left", true: "center", false: "left" }
            }
          },
          tablet: {},
          mobile: {}
        }} />
    )}
    <Heading text={title} fade="0.2" size="2" tag="2" class={cx(style({ base: {} }, __props, { instance: true }), variants(__props, {
        isCenter: { default: "text-left", true: "text-center", false: "text-left" }
      })) + " max-w-[640px]"} __menoStyle={{
        base: {
          textAlign: {
            _mapping: true,
            prop: "isCenter",
            values: { default: "left", true: "center", false: "left" }
          }
        }
      }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={cx(style({ base: {} }, __props, { instance: true }), variants(__props, {
          isCenter: { default: "text-left", true: "text-center", false: "text-left" }
        })) + " max-w-[580px]"} __menoStyle={{
          base: {
            textAlign: {
              _mapping: true,
              prop: "isCenter",
              values: { default: "left", true: "center", false: "left" }
            }
          }
        }} />
    )}
  </div>
  <Grid columns="1" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({}, __props, { label: "Stat Item" }) + " mb-6 flex flex-col gap-2"}>
        <div class={style({}, __props, { label: "Label Row" }) + " flex justify-between items-center"}>
          <Text text={item.label} weight="semibold" />
          <Heading text={item.value} size="5" tag="3" color="primary" />
        </div>
        <div class={style({}, __props, { label: "Progress Bar Background" }) + " w-full h-2 bg-[var(--bg-100)] rounded-[4px] overflow-hidden"}><div class={style({ base: { width: "{{item.value}}%" } }, __props, { label: "Progress Bar Fill" }) + " h-full bg-text rounded-[4px] transition-[width_0.3s_ease]"} style={`--m-base-width: ${item.value}%`} /></div>
        {item.description && (
          <Text text={item.description} size="small" color="light" />
        )}
      </div>
    ))}
  </Grid>
</Section>
