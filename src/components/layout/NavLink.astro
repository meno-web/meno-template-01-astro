---
import { cx, resolveProps } from 'meno-astro';
import { Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  link: { type: "link" }
});
const { text, link, class: className } = __props;
---
<li class={cx("[list-style:none]", className)}><Link href="#" class="p-[32px_12px] block text-text no-underline cursor-pointer transition-[background_0.2s] max-lg:p-[24px_20px]">{text}</Link></li>
