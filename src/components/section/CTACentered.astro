---
import { resolveProps, style } from 'meno-astro';
import Button from '../ui/Button.astro';
import ButtonList from '../ui/ButtonList.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Stack from '../ui/Stack.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: { type: "rich-text", default: "Your call to action headline" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  buttonText: { type: "string", default: "Primary action" },
  buttonLink: { type: "link", default: "#" },
  secondaryButtonText: { type: "string", default: "Secondary action" },
  secondaryButtonLink: { type: "link", default: "#" },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  title,
  text,
  buttonText,
  buttonLink,
  secondaryButtonText,
  secondaryButtonLink,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <Stack vertical="top" horizontal="center">
    <Heading text={title} size="2" tag="2" fade="0" class={style({ base: { maxWidth: "440px", textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "440px", textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" isMarginBottom={true} fade="0.2" class={style({ base: { maxWidth: "450px", textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "450px", textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    {buttonText && (
      <ButtonList justify="center" fade="0.4">
        <Button text={buttonText} link={buttonLink} variant="primary" />
        {secondaryButtonText && (
          <Button text={secondaryButtonText} link={secondaryButtonLink} variant="secondary" />
        )}
      </ButtonList>
    )}
  </Stack>
</Section>
