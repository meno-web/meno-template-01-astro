---
import { cx, href, resolveProps, style, variants } from 'meno-astro';
import { Embed, Link } from 'meno-astro/components';

const __props = resolveProps(Astro, {
  text: { type: "string", default: "Link" },
  variant: {
    type: "select",
    default: "primary",
    options: ["primary", "secondary"]
  },
  isMarginTop: { type: "boolean", default: false },
  link: { type: "link" },
  fade: { type: "string", default: "" }
});
const { text, variant, isMarginTop, link, fade, class: className } = __props;
---
<Link href={href({ _mapping: true, prop: "link" }, __props)} class={cx(style({ base: {} }, __props, {
    interactive: [
      {
        name: "on hover",
        postfix: ":hover",
        style: {
          base: {
            backgroundColor: {
              _mapping: true,
              prop: "variant",
              values: { primary: "var(--text-100)", secondary: "var(--bg-100)" }
            },
            borderColor: {
              _mapping: true,
              prop: "variant",
              values: {
                primary: "var(--text-100)",
                secondary: "var(--border-100)"
              }
            },
            top: "0"
          }
        }
      }
    ],
    label: "button"
  }), variants(__props, {
    variant: {
      primary: "border-(--text) bg-(--text) text-(--bg)",
      secondary: "border-(--border) bg-(--bg) text-(--text)"
    },
    isMarginTop: {
      primary: "mt-[30px]",
      true: "mt-[30px]",
      false: "mt-[0]",
      secondary: ""
    }
  }), "p-(--b-p) flex flex-row items-center gap-(--b-g) border-[1px_solid] rounded-(--b-br) text-(length:--b-fs) font-(number:--b-fw) no-underline cursor-pointer transition-[all_0.2s]", className)}>
  <span class={style({}, __props, { label: "text" })}>{text}</span>
  <Embed html={`<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>`} class={style({}, __props, { label: "arrow" }) + " h-[18px]"} />
</Link>
