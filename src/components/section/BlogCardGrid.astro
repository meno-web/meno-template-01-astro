---
import { list, resolveProps, style } from 'meno-astro';
import { Link } from 'meno-astro/components';
import Badge from '../ui/Badge.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Spacer from '../ui/Spacer.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Blog" },
  title: { type: "rich-text", default: "Latest articles" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      image: { type: "file", default: "/images/placeholder-img.webp" },
      label: { type: "string", default: "Category" },
      title: { type: "string", default: "Article Title" },
      text: { type: "string", default: "Article excerpt goes here." },
      link: { type: "link", default: "#" },
      date: { type: "string", default: "Jan 1, 2025" }
    },
    default: [
      {
        image: "/images/placeholder-img.webp",
        label: "Category",
        title: "Article title goes here",
        text: "Short excerpt that previews how this article card looks and reads in the editor.",
        link: "#",
        date: "Jan 15, 2025"
      },
      {
        image: "/images/placeholder-img.webp",
        label: "Category",
        title: "Article title goes here",
        text: "Short excerpt that previews how this article card looks and reads in the editor.",
        link: "#",
        date: "Jan 10, 2025"
      },
      {
        image: "/images/placeholder-img.webp",
        label: "Category",
        title: "Article title goes here",
        text: "Short excerpt that previews how this article card looks and reads in the editor.",
        link: "#",
        date: "Jan 5, 2025"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} class={style({ base: { maxWidth: "600px" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "600px" }, tablet: {}, mobile: {} }}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </SectionHeader>
  <Grid columns="3" gap="16" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Link href={item.link} class={style({
          base: {
            display: "flex",
            textDecoration: "none",
            borderRadius: "16px",
            overflow: "hidden",
            backgroundColor: "var(--surface)",
            border: "1px solid var(--border-100)",
            transition: "transform 0.2s ease, box-shadow 0.2s ease",
            flexDirection: "column"
          },
          tablet: {},
          mobile: {}
        }, __props, {
          interactive: [
            {
              prefix: "",
              postfix: ":hover",
              style: { base: { transform: "translateY(-4px)" } }
            }
          ]
        })}>
        <div class={style({ base: { height: "200px", overflow: "hidden" } }, __props)}><Image image={item.image} alt={item.title} objectFit="cover" width="100%" height="200px" /></div>
        <div class={style({
            base: { padding: "24px", flexGrow: "1", backgroundColor: "var(--bg)" },
            tablet: {},
            mobile: {}
          }, __props)}>
          <Badge text={` ${item.label}`} />
          <Spacer size="16" />
          <Heading text={item.title} size="5" tag="3" />
          <span class={style({ base: { fontSize: "13px", color: "var(--text-100)" } }, __props)}>{item.date}</span>
          <Spacer size="16" />
          <Text text={item.text} size="small" variant="light" />
        </div>
      </Link>
    ))}
  </Grid>
</Section>
