---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Features" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  columns: { type: "select", default: "3", options: ["2", "3", "4", "6"] },
  theme: { type: "select", default: "light", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      icon: { type: "select", default: "zap", enumName: "icons" },
      title: { type: "string", default: "Feature" },
      text: { type: "rich-text" }
    },
    default: [
      {
        icon: "zap",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "settings",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "shield",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "headphones",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "trending-up",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      },
      {
        icon: "bar-chart-3",
        title: "Feature title",
        text: "Short description of this item that previews how the list looks."
      }
    ]
  }
});
const {
  subtitle,
  title,
  text,
  columns,
  theme,
  items,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "640px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" class={style({ base: { maxWidth: "400px", textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "400px", textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <Grid columns={columns} fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({
          base: {
            display: "flex",
            flexDirection: "column",
            alignItems: "center",
            textAlign: "center",
            padding: "32px 24px",
            background: "var(--bg-100)",
            borderRadius: "12px"
          },
          tablet: {},
          mobile: {}
        }, __props, { label: "Card" })}>
        <div class={style({
            base: {
              width: "64px",
              height: "64px",
              backgroundColor: "var(--bg-200)",
              borderRadius: "16px",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              marginBottom: "20px"
            },
            tablet: {},
            mobile: {}
          }, __props, { label: "Icon Wrap" })}><Icon size={24} icon={item.icon} color="" /></div>
        <Heading text={item.title} size="5" tag="3" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
        <Text text={item.text} size="small" class={style({ base: { textAlign: "center", color: "var(--text-100)" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center", color: "var(--text-100)" }, tablet: {}, mobile: {} }} />
      </div>
    ))}
  </Grid>
</Section>
