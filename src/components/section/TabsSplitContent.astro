---
import { list, resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Image from '../ui/Image.astro';
import Section from '../ui/Section.astro';
import Spacer from '../ui/Spacer.astro';
import SplitContent from '../ui/SplitContent.astro';
import Stack from '../ui/Stack.astro';
import Tab from '../ui/Tab.astro';
import TabButton from '../ui/TabButton.astro';
import TabButtonsList from '../ui/TabButtonsList.astro';
import TabPanel from '../ui/TabPanel.astro';
import TabPanelsList from '../ui/TabPanelsList.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  theme: { type: "select", default: "primary", enumName: "theme" },
  items: {
    type: "list",
    itemSchema: {
      tabTitle: { type: "string", default: "Tab" },
      title: { type: "string", default: "Tab" },
      text: { type: "rich-text", default: "Text" },
      image: {
        type: "file",
        accept: "image/*",
        default: "/images/placeholder-img.webp"
      }
    },
    default: [
      {
        tabTitle: "Tab 1",
        title: "Tab 1",
        text: "Text",
        image: "/images/placeholder-img.webp"
      },
      {
        tabTitle: "Tab 2",
        title: "Tab 2",
        text: "Text",
        image: "/images/placeholder-img.webp"
      }
    ]
  }
});
const { title, text, theme, items, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center">
    <Heading text={title} size="2" tag="2" fade="0" class="max-w-[640px] text-center" />
    {text && (
      <Text text={text} size="large" isMarginBottom={true} fade="0.2" class="max-w-[580px] text-center" />
    )}
  </div>
  <Tab fade="0.4">
    <TabButtonsList>
      {list(items).map((item, itemIndex) => (
        <TabButton isActive={(itemIndex === 0)} text={item.tabTitle} />
      ))}
    </TabButtonsList>
    <Spacer size="32" />
    <TabPanelsList>
      {list(items).map((item, itemIndex) => (
        <TabPanel isOpen={(itemIndex === 0)}>
          <SplitContent vertical="top" horizontal="center">
            <Stack vertical="center">
              <Heading text={item.title} size="2" />
              <Text text={item.text} />
            </Stack>
            <Image image={item.image} height="420px" />
          </SplitContent>
        </TabPanel>
      ))}
    </TabPanelsList>
  </Tab>
</Section>
