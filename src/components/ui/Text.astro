---
import { resolveProps, style } from 'meno-astro';

const __props = resolveProps(Astro, {
  variant: {
    type: "select",
    default: "default",
    options: ["default", "light", "lighter"]
  },
  size: {
    type: "select",
    default: "default",
    options: ["default", "large", "small"]
  },
  text: { type: "rich-text", default: "Text" },
  align: {
    type: "select",
    default: "left",
    options: ["left", "center", "right", "inherit"]
  },
  fade: { type: "string", default: "" }
});
const {
  variant,
  size,
  text,
  align,
  fade,
  class: className,
} = __props;

const __meno = { acceptsStyles: true };
---
<p class={style({
    base: {
      fontSize: {
        _mapping: true,
        prop: "size",
        values: {
          default: "var(--t-fs)",
          large: "var(--tl-fs)",
          small: "var(--ts-fs)"
        }
      },
      lineHeight: "150%",
      fontWeight: "var(--t-fw)",
      color: {
        _mapping: true,
        prop: "variant",
        values: {
          default: "var(--text)",
          light: "var(--text-100)",
          lighter: "var(--text-200)"
        }
      },
      textAlign: {
        _mapping: true,
        prop: "align",
        values: {
          default: "left",
          left: "left",
          center: "center",
          right: "right",
          inherit: "inherit"
        }
      }
    },
    tablet: {},
    mobile: {}
  }, __props, { root: true })} fade={fade || undefined}><Fragment set:html={text} /></p>
