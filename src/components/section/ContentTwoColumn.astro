---
import { resolveProps, style } from 'meno-astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SplitContent from '../ui/SplitContent.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Features" },
  title: { type: "rich-text", default: "Your section heading" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  leftText: {
    type: "rich-text",
    default: "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that speaks to your audience and supports the heading above."
  },
  rightText: {
    type: "rich-text",
    default: "Short supporting paragraph that previews how this column looks in the editor. Replace this placeholder copy with your own message that continues the narrative from the left column."
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const {
  subtitle,
  title,
  text,
  leftText,
  rightText,
  theme,
  class: className,
} = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class={style({ base: { display: "flex", flexDirection: "column", alignItems: "center", marginBottom: "var(--sh-mb)", marginRight: "auto", marginLeft: "auto", maxWidth: "500px" }, tablet: {}, mobile: {} }, __props)}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} fade="0.2" size="2" tag="2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" fade="0.4" isMarginBottom={true} class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </div>
  <SplitContent>
    <Text text={leftText} fade="0.4" size="default" />
    <Text text={rightText} fade="0.6" size="default" />
  </SplitContent>
</Section>
