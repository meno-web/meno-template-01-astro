---
import { list, resolveProps, style } from 'meno-astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "By the numbers" },
  title: { type: "rich-text", default: "Trusted by thousands" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      value: { type: "string", default: "100+" },
      label: { type: "string", default: "Label" }
    },
    default: [
      { value: "10K+", label: "Happy customers" },
      { value: "99%", label: "Satisfaction rate" },
      { value: "50M+", label: "Tasks completed" },
      { value: "24/7", label: "Support available" }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <div class="mr-auto mb-(--sh-mb) ml-auto flex flex-col items-center">
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class="text-center" />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class="max-w-[640px] text-center" />
    {text && (
      <Text text={text} size="large" isMarginBottom={true} fade="0.4" class="max-w-[580px] text-center" />
    )}
  </div>
  <Grid columns="4" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <div class={style({}, __props, { label: "Stat Card" }) + " p-6 text-center"}>
        <Heading text={item.value} tag="3" size="1" class="text-center" />
        <Text text={item.label} color="secondary" class="text-center" />
      </div>
    ))}
  </Grid>
</Section>
