---
import { list, resolveProps, style } from 'meno-astro';
import Avatar from '../ui/Avatar.astro';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Heading from '../ui/Heading.astro';
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Subtitle from '../ui/Subtitle.astro';
import Text from '../ui/Text.astro';

const __props = resolveProps(Astro, {
  subtitle: { type: "string", default: "Testimonials" },
  title: { type: "rich-text", default: "What people are saying" },
  text: {
    type: "rich-text",
    default: "Short supporting description that previews how this section looks and reads in the editor."
  },
  items: {
    type: "list",
    itemSchema: {
      text: {
        type: "rich-text",
        default: "\"A short testimonial quote goes here about a positive experience.\""
      },
      image: { type: "file", default: "/images/placeholder-img.webp" },
      title: { type: "string", default: "Name" },
      label: { type: "string", default: "Job title, Company Name" }
    },
    default: [
      {
        text: "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        label: "Job title, Company Name"
      },
      {
        text: "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        label: "Job title, Company Name"
      },
      {
        text: "\"A short testimonial quote goes here about a positive experience with your brand or offering.\"",
        image: "/images/placeholder-img.webp",
        title: "Jane Doe",
        label: "Job title, Company Name"
      }
    ]
  },
  theme: { type: "select", default: "primary", enumName: "theme" }
});
const { subtitle, title, text, items, theme, class: className } = __props;
---
<Section theme={theme} spaceTop="default" class={style({}, __props, { root: true })}>
  <SectionHeader isCenter={true} class={style({ base: { maxWidth: "450px" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { maxWidth: "450px" }, tablet: {}, mobile: {} }}>
    {subtitle && (
      <Subtitle text={subtitle} fade="0" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
    <Heading text={title} size="2" tag="2" fade="0.2" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    {text && (
      <Text text={text} size="large" isMarginBottom={true} fade="0.4" class={style({ base: { textAlign: "center" }, tablet: {}, mobile: {} }, __props, { instance: true })} __menoStyle={{ base: { textAlign: "center" }, tablet: {}, mobile: {} }} />
    )}
  </SectionHeader>
  <Grid columns="3" gap="24" fade="0.4">
    {list(items).map((item, itemIndex) => (
      <Card item={item}>
        <Text text={item.text} />
        <div class={style({
            base: {
              display: "flex",
              alignItems: "center",
              gap: "12px",
              marginTop: "24px"
            }
          }, __props)}>
          <Avatar image={item.image} alt={item.title} size="large" />
          <div>
            <Heading text={item.title} size="6" tag="0" />
            <Text text={item.label} variant="light" size="small" />
          </div>
        </div>
      </Card>
    ))}
  </Grid>
</Section>
